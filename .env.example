# ============================================================
# ENTERPRISE PRODUCTIVITY APP — Environment Configuration
# Copy this file to .env and fill in all values
# ============================================================

# App
NODE_ENV=production
APP_NAME="Enterprise Productivity"
APP_VERSION=1.0.0
PORT=5000
FRONTEND_URL=http://localhost:3000
MOBILE_DEEP_LINK=productivityapp://

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-64-chars-change-in-prod
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET=your-otp-secret-key
OTP_EXPIRES_MINUTES=10

# SQL Server (Primary)
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=ProductivityDB
DB_USER=sa
DB_PASSWORD=YourStrong@Password123
DB_SCHEMA=dbo
DATABASE_URL="sqlserver://sqlserver:1433;database=ProductivityDB;user=sa;password=YourStrong@Password123;trustServerCertificate=true"

# MySQL (Compatibility layer — optional, set USE_MYSQL=true to switch)
USE_MYSQL=false
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ProductivityDB
MYSQL_USER=root
MYSQL_PASSWORD=YourMySQLPassword123
MYSQL_DATABASE_URL="mysql://root:YourMySQLPassword123@mysql:3306/ProductivityDB"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YourRedisPassword123
REDIS_TTL=3600

# MinIO / S3 File Storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_TASKS=task-attachments
MINIO_BUCKET_AVATARS=user-avatars
MINIO_BUCKET_SCREENSHOTS=screenshots
MINIO_BUCKET_VOICE=voice-notes

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Productivity App <noreply@yourcompany.com>"

# Push Notifications — Firebase Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-fcm-sender-id
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOC_TYPES=application/pdf,application/msword
ALLOWED_AUDIO_TYPES=audio/webm,audio/mp4,audio/mpeg

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=GrafanaAdmin123

# Logging
LOG_LEVEL=info
LOG_DIR=/var/log/productivity-app

# Backup
BACKUP_DIR=/var/backups/productivity-app
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=company-db-backups

# AI Features
AI_PRODUCTIVITY_ENABLED=true
AI_LOW_PRODUCTIVITY_THRESHOLD=40
AI_DELAY_PREDICTION_LOOKAHEAD_DAYS=3

# Gamification
GAMIFICATION_ENABLED=true
POINTS_TASK_COMPLETE=10
POINTS_ON_TIME_BONUS=5
POINTS_EARLY_BONUS=10

# Escalation
ESCALATION_CHECK_INTERVAL_MINUTES=30
ESCALATION_GRACE_HOURS=2
