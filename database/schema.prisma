// ============================================================
// Prisma Schema - Enterprise Productivity App  v3
// PostgreSQL (Neon.tech free tier)
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- DEPARTMENT -------------------------------------------------
model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?
  description String?
  managerId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager User?  @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users   User[] @relation("UserDepartment")
  teams   Team[]

  @@index([managerId])
  @@map("Departments")
}

// --- ROLE -------------------------------------------------------
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("Roles")
}

// --- SHIFT ------------------------------------------------------
model Shift {
  id              String   @id @default(uuid())
  name            String   @unique
  shiftType       String   @default("FLEXIBLE")
  startTime       String
  endTime         String
  workingDays     String   @default("[1,2,3,4,5]")
  gracePeriodMins Int      @default(15)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]   @relation("UserShift")

  @@map("Shifts")
}

// --- PLANT ------------------------------------------------------
model Plant {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  address     String?
  city        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserPlant")

  @@map("Plants")
}

// --- USER -------------------------------------------------------
model User {
  id               String    @id @default(uuid())
  employeeId       String    @unique
  firstName        String
  lastName         String
  email            String    @unique
  phone            String?
  passwordHash     String
  roleId           String
  departmentId     String?
  teamId           String?
  shiftId          String?
  plantId          String?
  status           String    @default("ACTIVE")
  avatarUrl        String?
  address          String?
  dateOfBirth      DateTime?
  joiningDate      DateTime  @default(now())
  shiftType        String    @default("FLEXIBLE")
  fcmToken         String?
  lastLoginAt      DateTime?
  lastActiveAt     DateTime?
  totalPoints      Int       @default(0)
  isOnline         Boolean   @default(false)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  role               Role               @relation(fields: [roleId],       references: [id], onDelete: NoAction, onUpdate: NoAction)
  department         Department?        @relation("UserDepartment",       fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team               Team?              @relation("TeamMembers",           fields: [teamId],       references: [id], onDelete: NoAction, onUpdate: NoAction)
  shift              Shift?             @relation("UserShift",             fields: [shiftId],      references: [id], onDelete: NoAction, onUpdate: NoAction)
  plant              Plant?             @relation("UserPlant",             fields: [plantId],      references: [id], onDelete: NoAction, onUpdate: NoAction)
  managedDepartments Department[]       @relation("DepartmentManager")
  ledTeams           Team[]             @relation("TeamLeader")
  assignedTasks      Task[]             @relation("TaskAssignee")
  createdTasks       Task[]             @relation("TaskCreator")
  taskComments       TaskComment[]
  notifications      Notification[]
  attendance         Attendance[]
  leaveRequests      LeaveRequest[]
  activityLogs       ActivityLog[]
  auditLogs          AuditLog[]
  performanceReviews PerformanceReview[] @relation("ReviewSubject")
  conductedReviews   PerformanceReview[] @relation("Reviewer")
  dailySummaries     DailySummary[]
  chatMessages       ChatMessage[]
  chatRoomMembers    ChatRoomMember[]
  productivityMetrics ProductivityMetric[]
  workTimeLogs       WorkTimeLog[]
  conductedLeaveReviews LeaveRequest[]  @relation("LeaveReviewer")
  announcements         Announcement[]
  badges                UserBadge[]
  leaderboardEntries    Leaderboard[]
  refreshTokens         RefreshToken[]
  otpRecords            OtpRecord[]

  // Gatepass hierarchy
  reportingManagerId    String?
  reportingManager      User?             @relation("UserRM", fields: [reportingManagerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportees             User[]            @relation("UserRM")
  gatepassRequests      GatepassRequest[] @relation("GatepassRequester")
  gatepassApprovals     GatepassRequest[] @relation("GatepassApprover")
  gatepassExitLogs      GatepassRequest[] @relation("GatepassExitGuard")
  gatepassReturnLogs    GatepassRequest[] @relation("GatepassReturnGuard")

  @@index([email])
  @@index([employeeId])
  @@index([roleId])
  @@index([departmentId])
  @@index([teamId])
  @@index([shiftId])
  @@index([plantId])
  @@index([status])
  @@index([deletedAt])
  @@map("Users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("RefreshTokens")
}

model OtpRecord {
  id        String   @id @default(uuid())
  userId    String
  otp       String
  purpose   String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("OtpRecords")
}

// --- TEAM -------------------------------------------------------
model Team {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String?
  description  String?
  leaderId     String?
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leader     User?       @relation("TeamLeader",  fields: [leaderId],     references: [id], onDelete: NoAction, onUpdate: NoAction)
  department Department? @relation(fields: [departmentId], references: [id])
  members    User[]      @relation("TeamMembers")
  tasks      Task[]
  chatRoom   ChatRoom?

  @@index([leaderId])
  @@index([departmentId])
  @@map("Teams")
}

// --- TASK -------------------------------------------------------
model Task {
  id               String    @id @default(uuid())
  title            String
  description      String?
  assigneeId       String
  createdById      String
  teamId           String?
  status           String    @default("PENDING")
  priority         String    @default("MEDIUM")
  category         String?
  dueDate          DateTime?
  estimatedHours   Float?
  actualHours      Float?
  startedAt        DateTime?
  completedAt      DateTime?
  rejectionReason  String?
  isRecurring      Boolean   @default(false)
  recurringPattern String?
  recurringEndDate DateTime?
  parentTaskId     String?
  slaHours         Float?
  isEscalated      Boolean   @default(false)
  escalatedAt      DateTime?
  escalatedTo      String?
  proofRequired    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  assignee     User             @relation("TaskAssignee", fields: [assigneeId],  references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy    User             @relation("TaskCreator",  fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team         Team?            @relation(fields: [teamId], references: [id])
  parentTask   Task?            @relation("TaskInstances", fields: [parentTaskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childTasks   Task[]           @relation("TaskInstances")
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("RequiredTask")
  comments     TaskComment[]
  attachments  Attachment[]
  history      TaskHistory[]
  workTimeLogs WorkTimeLog[]

  @@index([assigneeId])
  @@index([createdById])
  @@index([teamId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isEscalated])
  @@index([deletedAt])
  @@map("Tasks")
}

model TaskDependency {
  id          String   @id @default(uuid())
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())
  task        Task     @relation("DependentTask", fields: [taskId],      references: [id], onDelete: Cascade)
  dependsOn   Task     @relation("RequiredTask",  fields: [dependsOnId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([taskId, dependsOnId])
  @@map("TaskDependencies")
}

model TaskComment {
  id         String    @id @default(uuid())
  taskId     String
  userId     String
  content    String
  isInternal Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId])
  @@map("TaskComments")
}

model TaskHistory {
  id          String   @id @default(uuid())
  taskId      String
  changedById String
  field       String
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("TaskHistory")
}

model Attachment {
  id           String   @id @default(uuid())
  taskId       String?
  uploadedById String
  type         String
  fileName     String
  fileSize     Int
  mimeType     String
  storageKey   String
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId])
  @@map("Attachments")
}

// --- TIME TRACKING ----------------------------------------------
model WorkTimeLog {
  id         String    @id @default(uuid())
  userId     String
  taskId     String?
  startTime  DateTime
  endTime    DateTime?
  durationMs Int?
  isIdle     Boolean   @default(false)
  notes      String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([taskId])
  @@index([startTime])
  @@map("WorkTimeLogs")
}

// --- ATTENDANCE -------------------------------------------------
model Attendance {
  id             String    @id @default(uuid())
  userId         String
  date           DateTime  @db.Date
  checkInTime    DateTime?
  checkOutTime   DateTime?
  totalWorkHours Float?
  status         String    @default("PRESENT")
  isLate         Boolean   @default(false)
  adminNote      String?
  isCorrected    Boolean   @default(false)
  correctedById  String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("Attendance")
}

// --- LEAVE ------------------------------------------------------
model LeaveRequest {
  id           String    @id @default(uuid())
  userId       String
  type         String
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  reason       String
  isHalfDay    Boolean   @default(false)
  totalDays    Float     @default(1)
  status       String    @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User  @relation(fields: [userId],       references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer User? @relation("LeaveReviewer",         fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("LeaveRequests")
}

// --- KPI --------------------------------------------------------
model ProductivityMetric {
  id                 String   @id @default(uuid())
  userId             String
  date               DateTime @db.Date
  tasksCompleted     Int      @default(0)
  tasksPending       Int      @default(0)
  tasksOverdue       Int      @default(0)
  totalWorkHours     Float    @default(0)
  productivityScore  Float    @default(0)
  avgCompletionHours Float?
  delayPercentage    Float    @default(0)
  onTimeDeliveryRate Float    @default(0)
  slaBreaches        Int      @default(0)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("ProductivityMetrics")
}

// --- NOTIFICATIONS ----------------------------------------------
model Notification {
  id          String    @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String
  data        String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  sentViaPush Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("Notifications")
}

// --- PERFORMANCE REVIEWS ----------------------------------------
model PerformanceReview {
  id                String    @id @default(uuid())
  userId            String
  reviewerId        String
  period            String
  overallScore      Float?
  productivityScore Float?
  qualityScore      Float?
  attendanceScore   Float?
  teamworkScore     Float?
  comments          String?
  goals             String?
  status            String    @default("SUBMITTED")
  acknowledgedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User @relation("ReviewSubject", fields: [userId],     references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer User @relation("Reviewer",      fields: [reviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([reviewerId])
  @@map("PerformanceReviews")
}

// --- DAILY SUMMARY ----------------------------------------------
model DailySummary {
  id            String   @id @default(uuid())
  userId        String
  date          DateTime @db.Date
  summary       String
  tasksWorkedOn String   @default("[]")
  challenges    String?
  nextDayPlan   String?
  hoursWorked   Float?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("DailySummaries")
}

// --- CHAT -------------------------------------------------------
model ChatRoom {
  id          String   @id @default(uuid())
  name        String?
  isGroupChat Boolean  @default(false)
  teamId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team?    @relation(fields: [teamId], references: [id])
  members     ChatRoomMember[]
  messages    ChatMessage[]

  @@map("ChatRooms")
}

model ChatRoomMember {
  id         String    @id @default(uuid())
  roomId     String
  userId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roomId, userId])
  @@map("ChatRoomMembers")
}

model ChatMessage {
  id        String    @id @default(uuid())
  roomId    String
  senderId  String
  content   String?
  mediaUrl  String?
  mediaType String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  room      ChatRoom  @relation(fields: [roomId],   references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  @@map("ChatMessages")
}

// --- ANNOUNCEMENTS ----------------------------------------------
model Announcement {
  id         String    @id @default(uuid())
  authorId   String
  title      String
  content    String
  type       String    @default("GENERAL")
  targetType String    @default("COMPANY")
  targetId   String?
  isPinned   Boolean   @default(false)
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  author     User      @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([authorId])
  @@index([createdAt])
  @@map("Announcements")
}

// --- GAMIFICATION -----------------------------------------------
model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  icon        String      @default("🏅")
  color       String      @default("#0C66E4")
  condition   String      @default("{}")
  users       UserBadge[]

  @@map("Badges")
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId],  references: [id], onDelete: NoAction, onUpdate: NoAction)
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("UserBadges")
}

model Leaderboard {
  id        String   @id @default(uuid())
  userId    String
  period    String
  periodKey String
  points    Int      @default(0)
  rank      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, periodKey])
  @@index([periodKey, points])
  @@map("Leaderboard")
}

// --- GATEPASS ---------------------------------------------------
model GatepassRequest {
  id                 String    @id @default(uuid())
  passNumber         String    @unique
  requesterId        String
  outpassType        String    // OFFICIAL | PERSONAL | MEDICAL | EMERGENCY
  destination        String
  purpose            String
  isFullDay          Boolean   @default(false)   // true = won't return same day, false = half-day outpass
  expectedReturnTime DateTime?                   // null when isFullDay = true
  remarks            String?
  status             String    @default("PENDING")
  // PENDING | APPROVED | REJECTED | CANCELLED | EXITED | RETURNED

  approvedById       String?
  approvedAt         DateTime?
  approvalRemarks    String?

  actualExitTime     DateTime?
  exitRecordedById   String?
  actualReturnTime   DateTime?
  returnRecordedById String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  requester        User  @relation("GatepassRequester",   fields: [requesterId],       references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy       User? @relation("GatepassApprover",    fields: [approvedById],      references: [id], onDelete: NoAction, onUpdate: NoAction)
  exitRecordedBy   User? @relation("GatepassExitGuard",   fields: [exitRecordedById],  references: [id], onDelete: NoAction, onUpdate: NoAction)
  returnRecordedBy User? @relation("GatepassReturnGuard", fields: [returnRecordedById],references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requesterId])
  @@index([status])
  @@index([approvedById])
  @@index([createdAt])
  @@map("GatepassRequests")
}

// --- AUDIT & ACTIVITY -------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   String?
  newData   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("AuditLogs")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  event     String
  metadata  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@map("ActivityLogs")
}
